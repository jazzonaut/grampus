{
  "name": "grampus",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local coding-agent workflow controller",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:server && npm --prefix web run build",
    "build:server": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:server && node scripts/run-tests.mjs fast",
    "test:all": "npm run build:server && node scripts/run-tests.mjs all",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:full": "npm run typecheck && npm run lint && npm run format:check && npm run test:all",
    "start": "node dist/src/cli.js",
    "ui": "npm run build && node dist/src/cli.js ui",
    "build:orca-plugin": "npm run build && node scripts/build-orca-plugin.mjs",
    "install:local": "node scripts/install.mjs",
    "doctor": "node dist/src/cli.js doctor",
    "demo": "node dist/src/cli.js demo",
    "probe": "node dist/src/probes/probe.js",
    "probe:task": "node dist/src/probes/task-probe.js",
    "probe:multifile": "node dist/src/probes/multifile-probe.js",
    "probe:context": "node dist/src/probes/context-probe.js",
    "probe:exploration": "node dist/src/probes/exploration-probe.js",
    "probe:mcp": "node dist/src/probes/mcp-probe.js",
    "probe:references": "node dist/src/probes/reference-probe.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@openai/codex": "0.163.0",
    "zod": "4.6.7"
  }
}
